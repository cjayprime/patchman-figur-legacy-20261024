{
  "name": "figur-by-patchman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FIGUR by Patchman — a photo editor for your shape. MLS warp engine, body segmentation and compositing, in the browser.",
  "scripts": {
    "dev": "node scripts/start.mjs dev -p 3602",
    "build": "next build",
    "start": "node scripts/start.mjs start -p 3602",
    "lint": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./__tests__/register.mjs --import ./__tests__/environment.mjs --test \"__tests__/*.test.ts\" \"__tests__/*.check.ts\"",
    "test:mls": "node --import ./__tests__/register.mjs --test __tests__/mls.test.ts",
    "test:inpaint": "node --import ./__tests__/register.mjs --test __tests__/inpaint.test.ts",
    "predev": "node scripts/check-node.cjs && npm run migrate -- --env development && node scripts/check-database.cjs development",
    "prestart": "node scripts/check-node.cjs && npm run migrate -- --env production && node scripts/check-database.cjs production",
    "migrate": "sequelize-cli db:migrate --config lib/database/config.cjs --migrations-path migrations",
    "seed": "sequelize-cli db:seed:all --config lib/database/config.cjs --seeders-path seeders",
    "preinstall": "node scripts/check-node.cjs",
    "prebuild": "node scripts/check-node.cjs && npm run database:prepare",
    "test:projects": "node __tests__/integration/projects.mjs",
    "database:create": "node scripts/create-fresh-database.mjs",
    "test:workspace": "node __tests__/integration/workspace.browser.mjs",
    "database:prepare": "node scripts/prepare-database.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@next/env": "16.4.1",
    "driver.js": "^1.9.0",
    "mysql2": "^3.24.4",
    "next": "16.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.3"
  },
  "devDependencies": {
    "@antfu/eslint-define-config": "^1.23.0-2",
    "@arthurgeron/eslint-plugin-react-usememo": "^2.5.0",
    "@babel/core": "^7.28.3",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/eslint-plugin": "^7.12.1",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-class-properties": "^7.24.7",
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.12.7",
    "@next/eslint-plugin-next": "^14.2.35",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "babel-jest": "^30.1.2",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "expect": "^30.1.2",
    "jest": "^30.1.2",
    "jest-mock-axios": "^4.8.0",
    "krep": "^1.0.0",
    "nodemon": "^3.1.4",
    "playwright": "^1.63.0",
    "prettier": "^3.3.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
