DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
# Managed databases: verify-full checks the CA chain AND the DATABASE_HOST DNS name.
# disabled is for explicit local/trusted-network connections; never use an unverified TLS mode.
DATABASE_TLS_MODE=disabled
# Optional custom CA PEM (actual newlines or literal \n); blank uses Node's trusted roots.
DATABASE_TLS_CA=
# Alternative server-readable CA file. Set only one CA source; do not commit private files.
DATABASE_TLS_CA_FILE=
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=patchman_figur_v3

ENABLE_GLOBAL_RATE_LIMIT=true

# Single Account address for the browser SDK and backend clients.
NEXT_PUBLIC_ACCOUNT_URL=http://localhost:3600
# App-wide DB budget (code default 7; launch budget 6), including direct DB workers.
DATABASE_MAX_CONNECTIONS=6
DATABASE_WORKER_COUNT=0
# Server-only: use the SAME value in Account and every host within one environment.
# Staging: pm_account_staging; production: pm_account_session. Never use NEXT_PUBLIC_ here.
ACCOUNT_SESSION_COOKIE_NAME=pm_account_session
