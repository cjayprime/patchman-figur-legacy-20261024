DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=patchman_figur_v3

ENABLE_GLOBAL_RATE_LIMIT=true

# Single Account address for the browser SDK and backend clients.
NEXT_PUBLIC_ACCOUNT_URL=http://localhost:3600
# Server-only: use the SAME value in Account and every host within one environment.
# Staging: pm_account_staging; production: pm_account_session. Never use NEXT_PUBLIC_ here.
ACCOUNT_SESSION_COOKIE_NAME=pm_account_session
